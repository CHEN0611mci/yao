# ============================================================================
# 萌宠优选 · 宠物商城系统  仓库根 .gitignore
#
# 原则：只跟踪项目有效文件（源码 / SQL / 文档 / 脚本 / 配置模板）。
# 本机环境、辅助开发文件、构建产物、依赖、日志、备份均不入库。
# ============================================================================

# ---------- 根目录白名单：只保留项目必需入口，其余根目录文件一律忽略 ----------
/*
!/.gitattributes
!/.gitignore
!/README.md
!/RUNBOOK.md
!/00-START-HERE-AI-环境配置说明.md
!/VERSION.txt
!/*.bat
!/backend/
!/admin-ui/
!/user-ui/
!/config/
!/db/
!/docs/
!/scripts/
!/setup/
!/verify/

# ---------- Java / Maven 构建产物 ----------
**/target/
*.class
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties

# ---------- Node / 前端依赖与产物 ----------
**/node_modules/
**/dist/
**/.vite/
**/.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Python 缓存（文档生成脚本） ----------
**/__pycache__/
*.pyc

# ---------- 环境变量 / 密钥（禁止入库） ----------
.env
.env.*
!.env.example
!*.env.example
/config/backend.env
*.pem
*.key
*.p12
*.jks

# ---------- 日志 / 运行数据 / 备份 ----------
logs/
*.log
data/
uploads/
backup/
*.sql.gz
*.pid
*.tmp
*.bak
*.swp
*~
# 验收运行产物：每次冒烟执行都会变化，不入库
/verify/smoke-result.txt
/run/

# ---------- IDE / 操作系统 ----------
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.suo
Thumbs.db
Desktop.ini
.DS_Store

# ---------- Local tooling (Maven etc., not committed) ----------
/.tools/

# ---------- 前端构建临时缓存 ----------
**/.build-tmp/
