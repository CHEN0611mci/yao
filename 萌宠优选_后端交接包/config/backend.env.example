# ============================================================================
# 萌宠优选 · 后端本地配置（复制为 backend.env 后修改）
# 说明：
#   - backend.env 含有数据库密码，不要提交到 Git，也不要发给无关人员
#   - 值不要加引号；等号后面直接写值；# 开头为注释
#   - 本文件由 setup\start-backend.ps1 / init-db.ps1 / smoke-test.ps1 读取
# ============================================================================

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=shop
DB_USERNAME=root
# 改成你本机 MySQL root 密码；不确定时留空，启动脚本会提示输入
DB_PASSWORD=CHANGE_ME
# 本机 MySQL 无证书时保持 false；有正式证书可改 true
DB_USE_SSL=false

# 可选：mysql.exe 所在目录（脚本通常能自动找到，找不到时再填）
# MYSQL_HOME=C:\Program Files\MySQL\MySQL Server 8.0
# MYSQL_EXE=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysql.exe

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
# Redis 无密码时留空
REDIS_PASSWORD=

# ---------- 后端 ----------
SERVER_PORT=8080
# 上传目录；相对路径以包根目录为基准
RUOYI_PROFILE=data/uploadPath
# 日志目录；相对路径以包根目录为基准
LOG_PATH=logs
# 开发时想看 SQL/业务调试日志可改成 debug
LOG_LEVEL=info
# 源码开发热部署，可改 true；直接运行 jar 时保持 false
DEVTOOLS_RESTART=false

# ---------- 安全（正式部署必须修改） ----------
# 至少 32 位随机字符；本机演示可保持默认
TOKEN_SECRET=petmall-dev-token-secret-change-me
DRUID_USERNAME=ruoyi
DRUID_PASSWORD=123456

# ---------- 可选：JDK / Maven ----------
# 脚本会自动探测 JDK 17+；需要指定时填 JDK 根目录（不是 bin）
# JAVA_HOME=C:\Program Files\Java\jdk-17
# MAVEN_HOME=C:\dev\apache-maven-3.9.9
