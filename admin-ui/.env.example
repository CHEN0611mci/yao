# ============================================================================
# 管理端环境变量模板（可入库；真实 .env.development / .env.production 不入库）
#
# 首次使用：
#   copy .env.example .env.development
#   copy .env.example .env.production
# 再按需修改 VITE_APP_BASE_API / VITE_BUILD_COMPRESS
# ============================================================================

# 页面标题（浏览器标题、登录页与侧边栏 Logo 文案）
VITE_APP_TITLE = 萌宠优选 · 宠物商城系统

# 环境标识：development | production
VITE_APP_ENV = 'development'

# 接口前缀：开发 /dev-api（Vite 代理到 8080），生产 /prod-api（Nginx 反代）
VITE_APP_BASE_API = '/dev-api'

# 构建压缩：'none' | 'gzip' | 'gzip,brotli'
VITE_BUILD_COMPRESS = 'none'
